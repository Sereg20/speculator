# ─── Server ───────────────────────────────────────────────
# Option A — Neon (free serverless Postgres): https://neon.tech
#   New project → Dashboard → Connection string → copy "postgresql://..."
#   Add ?sslmode=require at the end if not already present
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Option B — Supabase (free Postgres): https://supabase.com
#   New project → Settings → Database → Connection string → URI mode
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Option C — local Postgres (if you have it installed)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/car_dealer

# ──────────────────────────────────────────────────────────
# Option A — Upstash (free serverless Redis): https://upstash.com
#   New database → Details → "Redis URL" (rediss://...)
REDIS_URL=rediss://default:password@host.upstash.io:port

# Option B — local Redis (if you have it installed)
# REDIS_URL=redis://localhost:6379

# Gemini Flash API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=           # optional, enables round-robin

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ─── Runtime tuning ───────────────────────────────────────
NODE_ENV=development         # development | test | production
LOG_LEVEL=info
PORT=3000

# AI dialogue generation: hard cutoff in ms before fallback fires
AI_TIMEOUT_MS=3000

# How many real-world minutes = 1 in-game day
# 120 = 2 hrs real time per game day (adjust during playtesting)
INGAME_DAY_REAL_MINUTES=120

# ─── Mobile (Expo) ────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SENTRY_DSN=
