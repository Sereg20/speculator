    "test": "node --test test/**/*.test.js"
  },
  "dependencies": {
    "@car-dealer/shared": "file:../../packages/shared",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "ioredis": "^5.3.2",
    "node-cron": "^3.0.3",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.4",
    "ret": "^0.5.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.5.0"
  }
